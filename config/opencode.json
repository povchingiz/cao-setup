{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nitec": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nitec Local",
      "options": {
        "baseURL": "https://llm.nitec.kz/v1",
        "apiKey": "{env:LOCAL_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Pro": {
          "name": "DeepSeek V4 Pro"
        },
        "moonshotai/Kimi-K3": {
          "name": "Kimi K3"
        },
        "zai-org/GLM-5.2-FP8": {
          "name": "GLM 5.2"
        }
      }
    }
  },
  "model": "nitec/deepseek-ai/DeepSeek-V4-Pro",
  "mcp": {
    "cao-mcp-server": {
      "type": "local",
      "command": [
        "/Users/yerta/.local/bin/cao-mcp-server"
      ],
      "enabled": true
    }
  },
  "tools": {
    "cao-mcp-server*": false
  },
  "agent": {
    "jcode_worker": {
      "tools": {
        "cao-mcp-server*": true
      }
    }
  }
}

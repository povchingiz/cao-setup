# Copy to .env and fill in. Never commit .env.
# API key for the bulk worker's OpenAI-compatible endpoint (OpenRouter or similar).
# opencode resolves {env:LOCAL_API_KEY} in ~/.aws/opencode/opencode.json at launch,
# and cao-run exports it into the tmux server env so worker panes inherit it.
LOCAL_API_KEY=sk-your-endpoint-key-here

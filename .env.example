# Copy to .env and fill in. Never commit .env.
# Local OpenAI-compatible endpoint API key for the DeepSeek bulk worker (opencode_worker).
# opencode resolves {env:LOCAL_API_KEY} in ~/.aws/opencode/opencode.json at launch,
# and cao-run exports it into the tmux server env so worker panes inherit it.
LOCAL_API_KEY=sk-your-nitec-key-here

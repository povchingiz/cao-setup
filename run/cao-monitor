#!/usr/bin/env python3
"""cao-monitor — live terminal dashboard for CAO tasks and sessions.

Reads cao_session/*/tasks.json and renders a real-time status board:
task status, assigned role, engine/model, elapsed runtime, comments, and QA verdict.

Usage:
  cao-monitor               show tasks for the latest session in current project
  cao-monitor --watch / -w  live refresh every 2 seconds (top/htop style)
  cao-monitor --all / -a    show tasks across all sessions in cao_session/
  cao-monitor --session N   inspect a specific session (e.g. session_001)
  cao-monitor --json        output raw tasks data as JSON
  cao-monitor -h | --help   show this help
"""
import argparse
import json
import os
import sys
import time
from datetime import datetime, timezone
from glob import glob
from pathlib import Path

# ANSI colors
CLR_RESET = "\033[0m"
CLR_BOLD = "\033[1m"
CLR_DIM = "\033[2m"
CLR_RED = "\033[1;31m"
CLR_GREEN = "\033[1;32m"
CLR_YELLOW = "\033[1;33m"
CLR_BLUE = "\033[1;34m"
CLR_MAGENTA = "\033[1;35m"
CLR_CYAN = "\033[1;36m"


def find_sessions(root_dir: Path):
    """Locate all session directories containing tasks.json."""
    candidates = []
    for s_name in ["wcao", "cao_session"]:
        session_dir = root_dir / s_name
        if session_dir.exists():
            # 1. Search session_*
            for d in sorted(session_dir.glob("session_*")):
                if d.is_dir() and (d / "tasks.json").exists():
                    candidates.append(d)
            # 2. Search sessions/session_*
            sessions_subdir = session_dir / "sessions"
            if sessions_subdir.exists():
                for d in sorted(sessions_subdir.glob("session_*")):
                    if d.is_dir() and (d / "tasks.json").exists():
                        candidates.append(d)
            # 3. Direct tasks.json in directory
            if (session_dir / "tasks.json").exists():
                candidates.append(session_dir)
        if candidates:
            break
    return candidates


def load_session_tasks(session_path: Path):
    """Load tasks.json and plan/context if available."""
    tasks_file = session_path / "tasks.json"
    if not tasks_file.exists():
        return None
    try:
        tasks = json.loads(tasks_file.read_text(encoding="utf-8"))
        if not isinstance(tasks, list):
            tasks = tasks.get("tasks", [])
        return tasks
    except Exception as e:
        return {"error": str(e)}


def fmt_duration(start_iso, done_iso=None):
    if not start_iso:
        return "-"
    try:
        s_dt = datetime.fromisoformat(start_iso.replace("Z", "+00:00"))
        if done_iso:
            e_dt = datetime.fromisoformat(done_iso.replace("Z", "+00:00"))
        else:
            e_dt = datetime.now(timezone.utc)
        sec = max(0, int((e_dt - s_dt).total_seconds()))
        if sec < 60:
            return f"{sec}s"
        m, s = divmod(sec, 60)
        if m < 60:
            return f"{m}m {s:02d}s"
        h, m = divmod(m, 60)
        return f"{h}h {m:02d}m"
    except Exception:
        return "-"


def status_badge(status):
    s = (status or "pending").lower()
    if s == "done":
        return f"{CLR_GREEN}✓ done{CLR_RESET}"
    if s == "running":
        return f"{CLR_BLUE}● running{CLR_RESET}"
    if s == "blocked":
        return f"{CLR_RED}✗ blocked{CLR_RESET}"
    return f"{CLR_DIM}◌ pending{CLR_RESET}"


def qa_badge(qa):
    if not qa:
        return f"{CLR_DIM}-{CLR_RESET}"
    if isinstance(qa, str):
        v = qa
    else:
        v = qa.get("verdict", "-")
    vl = v.lower()
    if "pass" in vl:
        return f"{CLR_GREEN}PASS{CLR_RESET}"
    if "block" in vl or "fail" in vl:
        return f"{CLR_RED}BLOCK{CLR_RESET}"
    if "warn" in vl:
        return f"{CLR_YELLOW}WARN{CLR_RESET}"
    return v[:6]


def render_board(sessions_data):
    lines = []
    lines.append("")
    lines.append(f"  {CLR_BOLD}cao-monitor — task orchestration board{CLR_RESET}")
    lines.append(f"  {CLR_DIM}Press Ctrl+C to exit · Updated {time.strftime('%H:%M:%S')}{CLR_RESET}")
    lines.append("")

    if not sessions_data:
        lines.append(f"  {CLR_YELLOW}(no active cao_session/*/tasks.json found in current directory){CLR_RESET}")
        lines.append(f"  {CLR_DIM}Start a task with `cao-run` or create a session to see it here.{CLR_RESET}")
        lines.append("")
        return "\n".join(lines)

    for s_name, tasks in sessions_data.items():
        if isinstance(tasks, dict) and "error" in tasks:
            lines.append(f"  [{s_name}] Error loading tasks: {tasks['error']}")
            continue

        total = len(tasks)
        counts = {"done": 0, "running": 0, "blocked": 0, "pending": 0}
        for t in tasks:
            st = (t.get("status") or "pending").lower()
            counts[st] = counts.get(st, 0) + 1

        summary = (
            f"{CLR_BOLD}{s_name}{CLR_RESET} "
            f"({CLR_BLUE}{counts['running']} running{CLR_RESET} · "
            f"{CLR_GREEN}{counts['done']} done{CLR_RESET} · "
            f"{CLR_RED}{counts['blocked']} blocked{CLR_RESET} · "
            f"{CLR_DIM}{counts['pending']} pending{CLR_RESET} / {total} total)"
        )
        lines.append(f"  {summary}")
        lines.append("  " + "─" * 78)
        lines.append(f"  {'ID':<5} {'STATUS':<14} {'ROLE':<11} {'ENGINE·MODEL':<24} {'DUR':<9} {'QA':<6} {'TITLE'}")
        lines.append("  " + "─" * 78)

        for t in tasks:
            tid = t.get("id", "t?")
            st_b = status_badge(t.get("status"))
            role = (t.get("role") or t.get("engine") or "dev")[:10]
            eng = t.get("engine", "-")
            mod = t.get("model", "")
            if mod:
                em = f"{eng}·{mod.split('/')[-1][:12]}"
            else:
                em = eng
            em = em[:23]
            dur = fmt_duration(t.get("started_at"), t.get("done_at"))
            qa_b = qa_badge(t.get("qa"))
            title = t.get("title", "")
            lines.append(f"  {tid:<5} {st_b:<23} {role:<11} {em:<24} {dur:<9} {qa_b:<14} {title}")

            # If there's a blocker or latest comment, show on subline
            comments = t.get("comments") or []
            if comments:
                last_c = comments[-1]
                c_text = last_c.get("text", "") if isinstance(last_c, dict) else str(last_c)
                lines.append(f"        {CLR_DIM}↳ {c_text[:65]}{CLR_RESET}")

        lines.append("")

    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(description="CAO Task & Session Board Monitor")
    parser.add_argument("-w", "--watch", action="store_true", help="Live auto-refresh (top/htop style)")
    parser.add_argument("-a", "--all", action="store_true", help="Show all sessions")
    parser.add_argument("-s", "--session", type=str, default=None, help="Inspect specific session name")
    parser.add_argument("--json", action="store_true", help="Output tasks as JSON")
    parser.add_argument("--dir", type=str, default=".", help="Working directory containing cao_session/")
    args = parser.parse_args()

    root = Path(args.dir).resolve()

    def collect():
        sessions = find_sessions(root)
        data = {}
        if not sessions:
            return data
        if args.session:
            filtered = [s for s in sessions if s.name == args.session]
        elif not args.all:
            filtered = [sessions[-1]]  # latest session
        else:
            filtered = sessions
        for s in filtered:
            data[s.name] = load_session_tasks(s)
        return data

    if args.json:
        print(json.dumps(collect(), indent=2))
        return

    if not args.watch:
        print(render_board(collect()))
        return

    # Watch mode
    try:
        # Clear screen on start
        sys.stdout.write("\033[2J\033[H")
        while True:
            data = collect()
            output = render_board(data)
            # Move cursor to top left and render
            sys.stdout.write("\033[H" + output + "\033[J")
            sys.stdout.flush()
            time.sleep(2)
    except KeyboardInterrupt:
        print(f"\n{CLR_DIM}cao-monitor closed.{CLR_RESET}")


if __name__ == "__main__":
    main()

#!/usr/bin/env bash
# cao-run — start the CAO orchestrator: pre-flight, daemon, then the supervisor.
#
#   cao-run                     health-check, then launch the supervisor
#   cao-run --skip-check        skip the cao-doctor pre-flight gate
#   cao-run -h | --help         show this help
#
# Any other arguments are passed through to `cao launch` unchanged.
#
# Supervisor engine is chosen automatically (so a burned Claude quota never
# leaves you stuck):
#   CAO_SUPERVISOR_PROVIDER=<engine>  force a specific engine (highest priority)
#   ~/.cao/supervisor_provider        fallback hint written by cao-doctor
#   claude_code                       default
# If claude_code is chosen but its launch fails, cao-run auto-retries once on a
# fallback engine (CAO_FALLBACK_PROVIDER > antigravity_cli > codex).
set -euo pipefail

SERVER_PORT=9889
LOG_DIR="$HOME/.cao/logs"
LOG_FILE="$LOG_DIR/server.log"
# Resolve through a symlink so we find sibling scripts (cao-doctor) in the repo,
# not wherever the symlink lives (e.g. ~/.local/bin).
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in /*) SELF="$TARGET" ;; *) SELF="$(dirname "$SELF")/$TARGET" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"

# Parse our own flags; collect the rest to pass through to `cao launch`.
# --skip-check works in ANY position, not just first.
SKIP_CHECK=0
PASSTHROUGH=()
while [ $# -gt 0 ]; do
  case "$1" in
    --skip-check) SKIP_CHECK=1 ;;
    -h|--help)    awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else if(NF){exit} }' "$0"; exit 0 ;;
    *)            PASSTHROUGH+=("$1") ;;
  esac
  shift
done

# Pre-flight health check (D1-D4). A failed REQUIRED check (missing
# binary/toolchain) aborts before launch; warnings don't block.
if [ "$SKIP_CHECK" = 0 ] && [ -x "$HERE/cao-doctor" ]; then
  "$HERE/cao-doctor" || { echo "Pre-flight failed. Fix the above or re-run with --skip-check."; exit 1; }
fi

# API key for the bulk worker's OpenAI-compatible endpoint.
# opencode resolves {env:LOCAL_API_KEY} in ~/.aws/opencode/opencode.json at launch.
# Look for LOCAL_API_KEY in the first env file that has it (portable across machines).
for ENV_FILE in \
  "$HOME/.config/cao/cao.env" \
  "$HOME/cao-setup/.env"; do
  if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    . "$ENV_FILE"
    set +a
    [ -n "${LOCAL_API_KEY:-}" ] && break
  fi
done

# 1. Start the CAO daemon if it is not already listening.
if ! nc -z 127.0.0.1 "$SERVER_PORT" >/dev/null 2>&1; then
  echo "⚡ Starting CAO background daemon..."
  mkdir -p "$LOG_DIR"
  # Pass LOCAL_API_KEY through to the server (and thus to spawned worker panes).
  LOCAL_API_KEY="${LOCAL_API_KEY:-}" nohup cao-server > "$LOG_FILE" 2>&1 &

  # Wait for the port to come up (up to 5s).
  for _ in {1..10}; do
    if nc -z 127.0.0.1 "$SERVER_PORT" >/dev/null 2>&1; then
      break
    fi
    sleep 0.5
  done

  if ! nc -z 127.0.0.1 "$SERVER_PORT" >/dev/null 2>&1; then
    echo "❌ Error: cao-server failed to start. Log: $LOG_FILE"
    exit 1
  fi
  echo "✓ CAO daemon active."
fi

# 2. Ensure the tmux server carries LOCAL_API_KEY so opencode worker panes inherit it.
#    (tmux is the backend CAO spawns worker CLIs in; its global env is not persistent
#     across a tmux server restart, so we re-assert it on every cao-run.)
if [ -n "${LOCAL_API_KEY:-}" ] && command -v tmux >/dev/null 2>&1; then
  tmux setenv -g LOCAL_API_KEY "$LOCAL_API_KEY" >/dev/null 2>&1 || true
fi

# 3. Pick the supervisor provider.
#    Priority: explicit env override > doctor's fallback hint > claude_code default.
#    This is the fix for "Claude quota ran out and I couldn't launch cao": you can
#    now run the supervisor on ANY registered engine without editing this script.
#      Manual switch:  CAO_SUPERVISOR_PROVIDER=antigravity_cli cao-run
#    cao-doctor writes ~/.cao/supervisor_provider when it detects Claude is
#    unavailable (quota/login), so an unattended cao-run auto-falls back to it.
DEFAULT_SUPERVISOR_PROVIDER="claude_code"
HINT_FILE="$HOME/.cao/supervisor_provider"
if [ -n "${CAO_SUPERVISOR_PROVIDER:-}" ]; then
  SUP_PROVIDER="$CAO_SUPERVISOR_PROVIDER"          # explicit override wins
elif [ -f "$HINT_FILE" ] && [ -s "$HINT_FILE" ]; then
  SUP_PROVIDER="$(tr -d '[:space:]' < "$HINT_FILE")"  # doctor's fallback hint
  echo "ℹ Claude unavailable per cao-doctor — supervisor falling back to '$SUP_PROVIDER'."
  echo "  (Override any time with CAO_SUPERVISOR_PROVIDER=... ; delete $HINT_FILE to reset.)"
else
  SUP_PROVIDER="$DEFAULT_SUPERVISOR_PROVIDER"
fi

# 4. Pick a launch-time fallback engine (used only if the primary launch fails,
#    which is the ONLY reliable signal of a burned Claude quota — auth status
#    can't see quota). Order: env CAO_FALLBACK_PROVIDER > antigravity_cli > codex.
pick_fallback() {
  if [ -n "${CAO_FALLBACK_PROVIDER:-}" ]; then echo "$CAO_FALLBACK_PROVIDER"
  elif command -v agy   >/dev/null 2>&1; then echo "antigravity_cli"
  elif command -v codex >/dev/null 2>&1; then echo "codex"
  else echo ""; fi
}

# 5. Launch the supervisor with its MCP orchestration tools.
#    --session-name gives a readable tmux session (cao-supervisor) so you can
#    reattach with `tmux attach -t cao-supervisor` instead of hunting a uuid.
#    (The server prepends the cao- prefix.) Workers the supervisor spawns via
#    the assign tool still get auto uuid session names; their tmux WINDOW is
#    named after the profile (e.g. coder_worker-xxxx), which stays readable.
#    ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"} safely expands an empty array under
#    `set -u` (a bare "${PASSTHROUGH[@]}" would error when there are no extras).
launch() {  # $1 = provider; remaining args are the passthrough
  local provider="$1"; shift
  echo "▶ Supervisor provider: $provider"
  cao launch --agents code_supervisor --provider "$provider" \
    --session-name supervisor --auto-approve "$@"
}

# Fast path: no fallback needed if an override/hint already moved us off claude,
# or if there's no fallback engine to try — just exec and be done.
FALLBACK="$(pick_fallback)"
if [ "$SUP_PROVIDER" != "claude_code" ] || [ -z "$FALLBACK" ] || [ "$FALLBACK" = "$SUP_PROVIDER" ]; then
  exec cao launch --agents code_supervisor --provider "$SUP_PROVIDER" \
    --session-name supervisor --auto-approve ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}
fi

# Primary is claude_code AND a distinct fallback exists: try claude, and if the
# launch fails (quota exhausted, login expired, engine error) auto-retry once on
# the fallback so you're never stuck the way you were when Claude ran out.
if launch "$SUP_PROVIDER" ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}; then
  exit 0
fi
echo "⚠ Supervisor launch on '$SUP_PROVIDER' failed — likely Claude quota/login." >&2
echo "  Auto-retrying on fallback engine '$FALLBACK'..." >&2
echo "  (Skip Claude next time with: CAO_SUPERVISOR_PROVIDER=$FALLBACK cao-run)" >&2
exec cao launch --agents code_supervisor --provider "$FALLBACK" \
  --session-name supervisor --auto-approve ${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}

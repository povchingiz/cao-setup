#!/usr/bin/env bash
# cao-stop — shut down the orchestrator: worker/supervisor tmux sessions + daemon.
# Nothing in CAO auto-stops (workers survive detach by design), so this is how you
# end a work session cleanly.
#
#   cao-stop            stop the daemon + every cao- tmux session (default)
#   cao-stop --project <name>  stop supervisor session for a specific project
#   cao-stop --all      stop all projects and daemon
#   cao-stop --workers  stop worker sessions only, leave the supervisor + daemon up
#   cao-stop --keep-server / -k
#                       kill the tmux sessions but leave the daemon running
set -e

# Read server_port from config (local overrides base), fall back to 9889.
_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_CFG="$_HERE/../setup/2_configure/cao.config.local.toml"
[ -f "$_CFG" ] || _CFG="$_HERE/../setup/2_configure/cao.config.toml"
SERVER_PORT="$(python3 -c "
import sys, tomllib
cfg = tomllib.load(open(sys.argv[1],'rb'))
print(cfg.get('orchestrator',{}).get('server_port', 9889))
" "$_CFG" 2>/dev/null)" || SERVER_PORT=9889
MODE=all
PROJECT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --workers)              MODE=workers ;;
    --keep-server|-k)       MODE=keep-server ;;
    --project)              PROJECT="$2"; shift ;;
    --all)                  MODE=all ;;
    -h|--help)
      awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else if(NF){exit} }' "$0"; exit 0 ;;
    *) echo "unknown flag: $1 (see --help)"; exit 1 ;;
  esac
  shift
done

killed=0
if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
  # cao- prefixes every session cao-run/assign creates. Supervisor = cao-supervisor[-<project>].
  for s in $(tmux ls -F '#{session_name}' 2>/dev/null | grep '^cao-' || true); do
    if [ -n "$PROJECT" ]; then
      if [ "$s" != "cao-supervisor-$PROJECT" ] && [ "$s" != "cao-supervisor" ]; then
        continue
      fi
    fi

    if [ "$MODE" = workers ]; then
      case "$s" in
        cao-supervisor*) continue ;;
      esac
    fi
    tmux kill-session -t "$s" 2>/dev/null && { echo "✓ stopped tmux session $s"; killed=1; }
  done
fi
[ "$killed" = 0 ] && echo "· no matching cao- tmux sessions running"

if [ "$MODE" = workers ] || [ "$MODE" = keep-server ] || [ -n "$PROJECT" ]; then
  if [ -n "$PROJECT" ] && [ "$MODE" != keep-server ]; then
    echo "· left daemon running for other projects (use cao-stop --all to stop daemon)"
  else
    echo "· daemon left running (cao-server on :$SERVER_PORT)"
  fi
  exit 0
fi

# Stop the background daemon that owns the sessions.
if pgrep -f 'cao-server' >/dev/null 2>&1; then
  pkill -f 'cao-server' && echo "✓ stopped cao-server daemon"
else
  echo "· cao-server daemon not running"
fi

#!/usr/bin/env bash
#
# cao-doctor — pre-flight health check for the CAO orchestrator.
# Verifies the environment is ready BEFORE you launch, so a worker doesn't fail
# silently mid-task. Grouped into four dimensions (D1-D4). Exits non-zero if any
# REQUIRED check fails; warnings don't block.
#
# Run standalone (`cao-doctor`) or automatically at the top of `cao-run`.
# Exit code: 0 = ready, non-zero = a required check failed.
#
set -uo pipefail

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) awk 'NR>1{ if(/^#/){sub(/^# ?/,"");print} else if(NF){exit} }' "$0"; exit 0 ;;
    *) echo "Unknown flag: $1. Run cao-doctor --help" >&2; exit 1 ;;
  esac
  shift
done

pass=0; warn=0; fail=0
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; pass=$((pass+1)); }
wrn()  { printf '  \033[1;33m!\033[0m %s\n' "$*"; warn=$((warn+1)); }
bad()  { printf '  \033[1;31m✗\033[0m %s\n' "$*"; fail=$((fail+1)); }
hdr()  { printf '\n\033[1m%s\033[0m\n' "$*"; }

# Resolve our own real location (through any symlink) so we can tell whether the
# cao-* tools on PATH point back at this repo or are stale copies.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  T="$(readlink "$SELF")"; case "$T" in /*) SELF="$T" ;; *) SELF="$(dirname "$SELF")/$T" ;; esac
done
RUN_DIR="$(cd "$(dirname "$SELF")" && pwd)"

# shellcheck source=run/_cao_common.sh
. "$RUN_DIR/_cao_common.sh"

SERVER_PORT="$(cao_server_port "$RUN_DIR")"

# Load LOCAL_API_KEY without printing it. Same resolution as cao-run.
cao_load_env "$RUN_DIR"

# --- D1: orchestrator toolchain ---------------------------------------------
hdr "D1 — Orchestrator toolchain"
for bin in cao cao-server; do
  if command -v "$bin" >/dev/null 2>&1; then ok "$bin on PATH"; else bad "$bin missing (run bootstrap.sh)"; fi
done
command -v tmux >/dev/null 2>&1 && ok "tmux present" || bad "tmux missing (CAO's terminal backend)"

# The cao-* tools on PATH should be THIS repo's scripts (bootstrap symlinks them).
# A stale copy (from an older `cp`-based install) silently runs old behavior —
# catch that here instead of leaving you puzzled why a new flag "doesn't work".
for tool in cao-run cao-doctor cao-stop cao-tokens cao-plugins cao-limits cao-monitor cao-aggressive cao-auto; do
  onpath="$(command -v "$tool" 2>/dev/null)" || { wrn "$tool not on PATH (run bootstrap.sh)"; continue; }
  if [ "$onpath" -ef "$RUN_DIR/$tool" ]; then
    :  # same file (symlink or direct) — fresh
  elif diff -q "$onpath" "$RUN_DIR/$tool" >/dev/null 2>&1; then
    :  # identical content — fine
  else
    wrn "$tool on PATH is STALE (a copy differing from run/$tool) — re-run bootstrap.sh to relink"
  fi
done
# A leftover supervisor session blocks the next cao-run with a 400 (not a quota
# error). Flag it here so it's obvious before launch.
if command -v tmux >/dev/null 2>&1 && tmux has-session -t cao-supervisor 2>/dev/null; then
  wrn "a 'cao-supervisor' tmux session is already running — reattach with 'tmux attach -t cao-supervisor', or clear it with 'cao-stop --keep-server' before cao-run"
fi
CAO_PY="$HOME/.local/share/uv/tools/cli-agent-orchestrator/bin/python"
if [ -x "$CAO_PY" ] && "$CAO_PY" -c 'import tomllib' 2>/dev/null; then
  ok "CAO Python has tomllib"
elif python3 -c 'import tomllib' 2>/dev/null; then
  ok "python3 has tomllib"
else
  wrn "no Python with tomllib (3.11+) — apply.sh/render will fail"
fi

# --- D2: worker CLIs (only the ones registered profiles use) ----------------
hdr "D2 — Worker engines"
# Map provider -> binary. Check the binary for every provider a profile uses.
check_engine() { # $1=label $2=binary
  if command -v "$2" >/dev/null 2>&1; then ok "$1: '$2' present"; else bad "$1: '$2' missing"; fi
}
check_engine "claude_code"     claude
check_engine "opencode_cli"    opencode
check_engine "codex"           codex
check_engine "antigravity_cli" agy
command -v copilot >/dev/null 2>&1 && ok "copilot_cli: 'copilot' present" || wrn "copilot_cli: 'copilot' missing (copilot_worker won't launch)"
command -v hermes >/dev/null 2>&1 && ok "hermes_cli: 'hermes' present" || wrn "hermes_cli: 'hermes' missing (hermes_worker won't launch)"


# --- D3: auth / logins (best-effort; some CLIs have no clean status) --------
hdr "D3 — Logins"
if command -v codex >/dev/null 2>&1; then
  if codex login status 2>&1 | grep -qi "logged in"; then ok "codex logged in"; else wrn "codex not logged in — run: codex login"; fi
fi
if [ -f "$HOME/.codex/auth.json" ]; then ok "codex auth.json present"; fi
# Antigravity onboarding (blocks init if not done)
ONB="$HOME/.gemini/antigravity-cli/cache/onboarding.json"
if [ -f "$ONB" ] && grep -q '"onboardingComplete": true' "$ONB" 2>/dev/null; then
  ok "antigravity onboarding complete"
else
  wrn "antigravity onboarding not marked complete — bootstrap sets this; else run: agy"
fi
# Claude: no clean scriptable quota check, so this is best-effort. The supervisor
# defaults to claude_code, so when Claude looks unavailable we write a fallback
# hint that cao-run reads to auto-switch the supervisor to another engine.
#   Fallback order: env CAO_FALLBACK_PROVIDER > antigravity_cli > codex.
HINT_FILE="$HOME/.cao/supervisor_provider"
pick_fallback() {
  if [ -n "${CAO_FALLBACK_PROVIDER:-}" ]; then echo "$CAO_FALLBACK_PROVIDER"
  elif command -v agy   >/dev/null 2>&1; then echo "antigravity_cli"
  elif command -v codex >/dev/null 2>&1; then echo "codex"
  else echo ""; fi
}
claude_unavailable_reason="" # empty = looks fine
if ! command -v claude >/dev/null 2>&1; then
  claude_unavailable_reason="claude binary missing"
else
  # `claude auth status` prints JSON with "loggedIn": true/false. It reports LOGIN
  # state only — it does NOT expose quota, so a burned quota is invisible here and
  # only surfaces when cao actually calls the API. We catch the login case (the
  # common "can't launch at all") and leave true-quota fallback to launch-time.
  probe="$(CLAUDE_NONINTERACTIVE=1 claude auth status 2>&1 || true)"
  if echo "$probe" | grep -qiE '"loggedIn"[[:space:]]*:[[:space:]]*false|not logged in|unauthenticated'; then
    claude_unavailable_reason="claude not logged in"
  fi
fi

if [ -n "$claude_unavailable_reason" ]; then
  fb="$(pick_fallback)"
  if [ -n "$fb" ]; then
    mkdir -p "$(dirname "$HINT_FILE")"
    printf '%s\n' "$fb" > "$HINT_FILE"
    wrn "$claude_unavailable_reason — supervisor will fall back to '$fb' (wrote $HINT_FILE)"
  else
    bad "$claude_unavailable_reason and no fallback engine (agy/codex) available"
  fi
else
  # Claude looks usable — clear any stale fallback hint so we go back to it.
  if [ -f "$HINT_FILE" ]; then rm -f "$HINT_FILE"; ok "claude logged in — cleared stale fallback hint"; else ok "claude logged in"; fi
  wrn "claude quota isn't checkable here (auth status has no quota field) — if exhausted, cao-run catches the launch failure and auto-retries on the fallback engine"
fi

# --- D4: bulk endpoint reachability -----------------------------------------
hdr "D4 — Bulk endpoint"
# Name the file that supplied the key (never the value) - a missing/mismatched
# env file was the hardest part of the cross-machine install to diagnose.
if [ -n "${CAO_ENV_SOURCE:-}" ]; then
  ok "LOCAL_API_KEY loaded from $CAO_ENV_SOURCE"
else
  wrn "LOCAL_API_KEY not found in any env file (set CAO_ENV_FILE, or create <repo>/.env)"
fi
OC_CFG="$HOME/.aws/opencode/opencode.json"
if [ ! -f "$OC_CFG" ]; then
  wrn "no opencode config yet — run apply.sh (bulk worker unconfigured)"
else
  BASE_URL="$(python3 -c "import json,sys; d=json.load(open('$OC_CFG')); p=d.get('provider',{}); v=next(iter(p.values()),{}); print(v.get('options',{}).get('baseURL',''))" 2>/dev/null)"
  if [ -z "$BASE_URL" ] || echo "$BASE_URL" | grep -q "<provider>"; then
    wrn "bulk endpoint not set (still the template placeholder)"
  elif [ -z "${LOCAL_API_KEY:-}" ]; then
    wrn "endpoint set ($BASE_URL) but LOCAL_API_KEY not found in env files"
  else
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 -H "Authorization: Bearer $LOCAL_API_KEY" "$BASE_URL/models" 2>/dev/null)"
    case "$code" in
      200) ok "endpoint reachable ($BASE_URL, 200)";;
      401|403) bad "endpoint rejects the key ($code) — check LOCAL_API_KEY";;
      000) bad "endpoint unreachable ($BASE_URL) — DNS/network/URL";;
      *) wrn "endpoint returned $code ($BASE_URL) — may still work";;
    esac
  fi
fi

# --- summary ----------------------------------------------------------------
hdr "Summary"
printf "  %d passed · %d warnings · %d failed\n" "$pass" "$warn" "$fail"
if [ "$fail" -gt 0 ]; then
  printf '\033[1;31mNot ready — fix the ✗ items above.\033[0m\n'
  exit 1
fi
printf '\033[1;32mReady.\033[0m\n'
exit 0

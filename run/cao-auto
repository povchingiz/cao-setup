#!/usr/bin/env python3
"""cao-auto — Headless autonomous execution runner for CAO task graphs.

Usage:
  cao-auto                  execute tasks in latest session in current directory
  cao-auto --session N      execute tasks for specific session (e.g. session_001)
  cao-auto --dry-run        simulate execution without launching real worker CLIs
  cao-auto --workers N      concurrency cap (default: 4)
  cao-auto -h | --help      show this help
"""
import argparse
import sys
from pathlib import Path

# Add repo root to python path so sibling run modules can be imported
SELF = Path(__file__).resolve()
REPO = SELF.parent.parent
sys.path.insert(0, str(REPO))

from run.cao_auto import AutonomousRunner, CaoClient
from run.cao_telegram import notify_telegram


def find_latest_session(root_dir: Path) -> Path:
    session_dir = root_dir / "cao_session"
    if not session_dir.exists():
        sys.exit(f"ERROR: No cao_session/ directory found in {root_dir}")
    sessions = sorted(
        [d for d in session_dir.glob("session_*") if d.is_dir() and (d / "tasks.json").exists()]
    )
    if not sessions:
        sys.exit(f"ERROR: No sessions with tasks.json found in {session_dir}")
    return sessions[-1]


def main():
    parser = argparse.ArgumentParser(description="CAO Headless Autonomous Execution Engine")
    parser.add_argument(
        "-s",
        "--session",
        type=str,
        default=None,
        help="Session directory name (e.g. session_001). Default: latest.",
    )
    parser.add_argument(
        "-d",
        "--dir",
        type=str,
        default=".",
        help="Project directory containing cao_session/. Default: current directory.",
    )
    parser.add_argument(
        "-w",
        "--workers",
        type=int,
        default=4,
        help="Maximum concurrent worker agents (default: 4).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simulate execution without starting live worker sessions.",
    )
    args = parser.parse_args()

    root = Path(args.dir).resolve()
    if args.session:
        session_path = root / "cao_session" / args.session
        if not session_path.exists() or not (session_path / "tasks.json").exists():
            sys.exit(f"ERROR: Session {args.session} not found or missing tasks.json in {session_path}")
    else:
        session_path = find_latest_session(root)

    tasks_file = session_path / "tasks.json"

    # Pre-flight daemon check unless dry-run
    client = CaoClient()
    if not args.dry_run and not client.is_healthy():
        print(f"❌ Error: CAO server daemon is not reachable on port 9889.", file=sys.stderr)
        print(f"   Start it first with: cao-run or run with --dry-run", file=sys.stderr)
        sys.exit(1)

    print(f"⚡ Starting CAO autonomous execution in {session_path.name}...")
    print(f"   Tasks file:  {tasks_file}")
    print(f"   Max workers: {args.workers}")
    if args.dry_run:
        print(f"   Mode:        DRY RUN (simulation)")
    print(f"   Watch live:  cao-monitor --watch\n")

    runner = AutonomousRunner(
        tasks_file=tasks_file,
        max_workers=args.workers,
        client=client,
        dry_run=args.dry_run,
    )

    success = runner.run()
    if success:
        print(f"\n✅ All tasks and automated audit completed successfully!")
        sys.exit(0)
    else:
        print(f"\n❌ Execution ended with unresolved blockers.", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

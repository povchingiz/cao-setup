#!/usr/bin/env python3
"""cao-tokens — token usage across the CLI engines the orchestrator drives.

No vendor billing API is called. Everything here is scraped from the local files
each CLI writes on this machine:

  claude    ~/.claude/projects/**/*.jsonl   (per-message `usage` blocks)
  codex     ~/.codex/state_5.sqlite          (threads.tokens_used per model)
  opencode  ~/.local/share/opencode/opencode.db (session table, incl. real cost)
  agy       — no local usage log; Google quota is server-side (dashboard only)

These are LIFETIME LOCAL token counts, not a live plan-limit readout.

On COST: claude and codex here run on flat-rate SUBSCRIPTIONS — tokens do not
bill per unit, so no dollar figure is shown (a per-token estimate would be a
fiction, not a bill). Only opencode hits a real per-token endpoint, and its cost
column is the value opencode itself computed and stored — that's the only real $.

On CACHE: the cache column counts cached context RE-READ each turn, so the same
tokens are counted many times over a long session. It is cheap plumbing, not
fresh usage — read `output` (real generation) as the number that matters.

On SCOPE: by default the claude figure is EVERY Claude Code session on this
machine (all projects), not only the ones cao drove. That total spans many days
of ordinary Claude use — so a big lifetime number is NOT "cao burning your
limits". Use --cao-only to count just the sessions that loaded cao's MCP server
(supervisor + workers), and --daily / --heatmap to see it per day instead of one
lifetime lump. (codex & opencode totals stay lifetime — their local stores have
no reliable per-day timeline here.)

Usage:
  cao-tokens                 DEFAULT: claude heatmap + per-day table (all engines),
                             last 7 days, CAO-ONLY. One column per engine; claude &
                             opencode cells are in/out, codex is a combined total.
  cao-tokens --since 2w      widen the window (24h / 7d / 2w / 3d ...)
  cao-tokens --lifetime / -a per-engine lifetime table (all history, no window)
  cao-tokens --day YYYY-MM-DD  just one date, e.g. --day 2026-09-17
  cao-tokens --claude        per-day CLAUDE only (input/output/cache detail)
  cao-tokens --heatmap       claude output heatmap only
  cao-tokens --extended / -x heatmap + claude daily + lifetime table
  cao-tokens --all-sessions  include NON-cao claude sessions too (off by default)
  cao-tokens --json          machine-readable form of the selected view

Notes:
  * CAO-ONLY is the default: claude counts only sessions that loaded cao's MCP
    server (a reliable marker). codex/opencode keep no such marker locally, so
    their columns are marked ~ and show ALL of that engine's use — in practice
    you rarely run them outside cao. A precise per-engine split would need
    request tracing (e.g. langfuse). Use --all-sessions to drop the claude filter.
  * "in/out" = input / output tokens. Output is real generation — the number
    that matters. codex reports one combined total (no in/out split).
  * $ appears only for opencode (its endpoint is metered); claude & codex are
    flat-rate subscriptions, so no per-token dollar figure is shown.
  * agy/gemini keeps no local usage log — its quota is server-side (dashboard),
    so it can't appear in these tables.
"""
import json
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))

from cao_lib import HOME, CAO_MARKERS, cutoff_ts, _iter_claude_files, _file_is_cao, _q, hn

# Which engines bill per token. Only these get a $ column; the rest are flat-rate
# subscriptions where a per-token dollar figure would be meaningless.
METERED = {"opencode"}




def _day_of(ts):
    """ISO date (UTC) from a claude timestamp like 2026-09-17T02:40:40.541Z."""
    if not ts:
        return None
    try:
        return ts[:10]
    except Exception:
        return None


# ---- claude scrape (shared core) -------------------------------------------
def _scan_claude(cutoff, cao_only, per_day):
    """Return (by_model, by_day). by_day is {date: dict(inp,out,cache)}."""
    by_model = {}
    by_day = defaultdict(lambda: dict(inp=0, out=0, cache=0))
    cutoff_dt = cutoff or 0
    for f in _iter_claude_files(cutoff):
        if cao_only and not _file_is_cao(f):
            continue
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"output_tokens"' not in line and '"input_tokens"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                msg = o.get("message") or {}
                u = msg.get("usage") or o.get("usage")
                if not u:
                    continue
                ts = o.get("timestamp")
                # Exact per-message time filter when --since is set.
                if cutoff_dt:
                    try:
                        mt = datetime.fromisoformat(
                            ts.replace("Z", "+00:00")).timestamp()
                        if mt < cutoff_dt:
                            continue
                    except Exception:
                        pass
                model = msg.get("model") or o.get("model") or "claude-unknown"
                inp = u.get("input_tokens", 0)
                out = u.get("output_tokens", 0)
                cache = u.get("cache_read_input_tokens", 0) + \
                    u.get("cache_creation_input_tokens", 0)
                a = by_model.setdefault(model, dict(inp=0, out=0, cache=0))
                a["inp"] += inp; a["out"] += out; a["cache"] += cache
                if per_day:
                    d = _day_of(ts)
                    if d:
                        by_day[d]["inp"] += inp
                        by_day[d]["out"] += out
                        by_day[d]["cache"] += cache
    return by_model, by_day


def scrape_claude(cutoff, cao_only=False):
    by_model, _ = _scan_claude(cutoff, cao_only, per_day=False)
    rows = []
    for model, a in by_model.items():
        if model in ("<synthetic>",) or a["inp"] + a["out"] + a["cache"] == 0:
            continue
        rows.append(dict(engine="claude", model=model, input=a["inp"],
                         output=a["out"], cache=a["cache"], cost=None))
    return rows


# ---- sqlite helpers --------------------------------------------------------


def scrape_codex(cutoff):
    db = HOME / ".codex" / "state_5.sqlite"
    rows = _q(db, "SELECT COALESCE(model,'?'), SUM(tokens_used) FROM threads GROUP BY model")
    if rows is None:
        return []
    out = []
    for model, toks in rows:
        toks = toks or 0
        if toks == 0:
            continue
        # codex reports one combined total, no in/out split.
        out.append(dict(engine="codex", model=model, input=toks, output=0,
                        cache=0, cost=None))
    return out


def scrape_opencode(cutoff):
    db = HOME / ".local" / "share" / "opencode" / "opencode.db"
    rows = _q(db, "SELECT COALESCE(model,'?'), SUM(tokens_input), SUM(tokens_output), "
                  "SUM(tokens_cache_read)+SUM(tokens_cache_write), SUM(cost) "
                  "FROM session GROUP BY model")
    if rows is None:
        return []
    out = []
    for model, ti, to, tc, cost in rows:
        ti, to, tc, cost = ti or 0, to or 0, tc or 0, cost or 0.0
        if ti + to + tc == 0:
            continue
        if model and model.startswith("{"):  # opencode stores model as JSON blob
            try:
                model = json.loads(model).get("id", model)
            except Exception:
                pass
        out.append(dict(engine="opencode", model=model, input=ti, output=to,
                        cache=tc, cost=round(cost, 4)))
    return out


# ---- per-day across ALL engines --------------------------------------------
def _empty_day():
    return {
        "claude": {"in": 0, "out": 0},
        "codex": {"used": 0},
        "opencode": {"in": 0, "out": 0, "cost": 0.0},
    }


def scan_all_daily(cutoff, cao_only):
    """{date -> {claude:{in,out}, codex:{used}, opencode:{in,out,cost}}} across
    every engine that records a per-message/per-session timestamp locally.
    (agy/gemini keeps no local usage log, so it can't appear here.)"""
    days = defaultdict(_empty_day)

    # claude — reuse the jsonl scan (already per-day, respects cao_only).
    _, cl_by_day = _scan_claude(cutoff, cao_only, per_day=True)
    for d, a in cl_by_day.items():
        days[d]["claude"]["in"] += a["inp"]
        days[d]["claude"]["out"] += a["out"]

    # codex — threads.created_at is unix SECONDS; tokens_used is a combined total.
    cdb = HOME / ".codex" / "state_5.sqlite"
    rows = _q(cdb, "SELECT created_at, tokens_used FROM threads WHERE tokens_used>0")
    for ts, toks in rows or []:
        if not ts or (cutoff and ts < cutoff):
            continue
        d = datetime.fromtimestamp(ts, timezone.utc).date().isoformat()
        days[d]["codex"]["used"] += toks or 0

    # opencode — session.time_created is unix MILLISECONDS; real in/out/cost.
    odb = HOME / ".local" / "share" / "opencode" / "opencode.db"
    rows = _q(odb, "SELECT time_created, tokens_input, tokens_output, cost FROM session")
    for tms, ti, to, cost in rows or []:
        if not tms:
            continue
        sec = tms / 1000.0
        if cutoff and sec < cutoff:
            continue
        d = datetime.fromtimestamp(sec, timezone.utc).date().isoformat()
        days[d]["opencode"]["in"] += ti or 0
        days[d]["opencode"]["out"] += to or 0
        days[d]["opencode"]["cost"] += cost or 0.0
    return days




def fmt(n):
    return f"{n:,}"


def cost_cell(r):
    if r["engine"] not in METERED:
        return "sub"           # flat-rate subscription — no per-token bill
    return f"{r['cost']:.2f}" if r["cost"] else "0.00"


# ---- views -----------------------------------------------------------------
def view_table(rows, since, cao_only):
    scope = "cao-only" if cao_only else "all claude sessions"
    print()
    print("  cao-tokens — local token counts" +
          (f"  (claude since {since})" if since else "  (lifetime)") +
          f"  [{scope}]")
    print("  " + "-" * 82)
    print(f"  {'engine':<9} {'model':<26} {'input':>12} {'output':>10} {'cache':>12} {'$':>6}")
    print("  " + "-" * 82)
    t_in = t_out = t_cache = 0
    t_cost = 0.0
    for r in sorted(rows, key=lambda r: -(r["output"] + r["input"])):
        print(f"  {r['engine']:<9} {r['model'][:26]:<26} {fmt(r['input']):>12} "
              f"{fmt(r['output']):>10} {fmt(r['cache']):>12} {cost_cell(r):>6}")
        t_in += r["input"]; t_out += r["output"]; t_cache += r["cache"]
        if r["engine"] in METERED and r["cost"]:
            t_cost += r["cost"]
    print("  " + "-" * 82)
    print(f"  {'TOTAL':<9} {'':<26} {fmt(t_in):>12} {fmt(t_out):>10} "
          f"{fmt(t_cache):>12} {t_cost:>6.2f}")
    print()
    print("  $  = real per-token cost (opencode endpoint only). 'sub' = flat-rate")
    print("       subscription (claude, codex) — tokens don't bill per unit.")
    print("  cache = context re-read each turn (same tokens counted repeatedly);")
    print("          it's cheap plumbing, not fresh usage. Read 'output' as spend.")
    print("  agy (gemini): no local usage log — quota is server-side (dashboard).")
    print("  scope: default counts ALL Claude Code sessions on this box; add")
    print("         --cao-only for just cao-driven ones, --daily/--heatmap per day.")
    print()


def view_daily_all(days, since, cao_only, one_day=None):
    """Per-day table, ONE column per engine, each cell = in/out (human-compact).
    codex reports a single combined total (no in/out split) -> shown as one
    number. opencode also gets a $ column (its endpoint is the only metered one).
    agy/gemini has no local log, so it isn't shown."""
    scope = "cao-only" if cao_only else "all sessions"
    dates = sorted(days)
    if one_day:
        dates = [d for d in dates if d == one_day]

    print()
    print(f"  cao-tokens — tokens per day  [{scope}]")
    if cao_only:
        print("  claude = cao sessions only · codex/opencode = ~all "
              "(no local cao marker — can't split)")
    print("  legend: claude & opencode cells are in/out · codex is combined · $ = opencode cost")
    # ~ marks the columns that can't be filtered to cao (codex/opencode).
    codex_h = "~codex" if cao_only else "codex"
    oc_h = "~opencode(in/out)" if cao_only else "opencode(in/out)"
    print("  " + "-" * 66)
    print(f"  {'date':<11} {'claude(in/out)':>16} {codex_h:>8} "
          f"{oc_h:>18} {'$':>6}")
    print("  " + "-" * 66)
    if not dates:
        print("  (no usage recorded in range)")
        print()
        return

    tc_in = tc_out = tx = to_in = to_out = 0
    t_cost = 0.0
    for d in dates:
        a = days[d]
        cl = f"{hn(a['claude']['in'])}/{hn(a['claude']['out'])}"
        cx = hn(a["codex"]["used"])
        oc = f"{hn(a['opencode']['in'])}/{hn(a['opencode']['out'])}"
        cost = a["opencode"]["cost"]
        print(f"  {d:<11} {cl:>16} {cx:>8} {oc:>18} {cost:>6.2f}")
        tc_in += a["claude"]["in"]; tc_out += a["claude"]["out"]
        tx += a["codex"]["used"]
        to_in += a["opencode"]["in"]; to_out += a["opencode"]["out"]
        t_cost += cost
    print("  " + "-" * 66)
    tcl = f"{hn(tc_in)}/{hn(tc_out)}"
    toc = f"{hn(to_in)}/{hn(to_out)}"
    print(f"  {'TOTAL':<11} {tcl:>16} {hn(tx):>8} {toc:>18} {t_cost:>6.2f}")
    print()
    if not one_day and dates:
        span = (datetime.fromisoformat(dates[-1]) -
                datetime.fromisoformat(dates[0])).days + 1
        print(f"  {len(dates)} active day(s) of {span} in range · "
              f"claude out {hn(tc_out)} · codex {hn(tx)} · opencode out {hn(to_out)}")
        print("  (agy/gemini has no local usage log — Google quota is server-side.)")
        print()


def view_daily(by_day, since, cao_only, one_day=None):
    scope = "cao-only" if cao_only else "all claude"
    print()
    if one_day:
        title = f"cao-tokens — claude output on {one_day}"
    else:
        title = "cao-tokens — claude output per day (LeetCode-style)"
    print(f"  {title}  [{scope}]")
    print("  " + "-" * 58)
    print(f"  {'date':<12} {'input':>12} {'output':>12} {'cache':>14}")
    print("  " + "-" * 58)
    days = sorted(by_day)
    if one_day:
        days = [d for d in days if d == one_day]
        if not days:
            print(f"  (no claude usage recorded on {one_day})")
            print()
            return
    t_in = t_out = t_cache = 0
    for d in days:
        a = by_day[d]
        # tiny inline bar scaled to the day's output within this window
        print(f"  {d:<12} {fmt(a['inp']):>12} {fmt(a['out']):>12} {fmt(a['cache']):>14}")
        t_in += a["inp"]; t_out += a["out"]; t_cache += a["cache"]
    print("  " + "-" * 58)
    print(f"  {'TOTAL':<12} {fmt(t_in):>12} {fmt(t_out):>12} {fmt(t_cache):>14}")
    if not one_day and days:
        # streak + peak, LeetCode/GitHub flavour
        peak = max(days, key=lambda d: by_day[d]["out"])
        active = len(days)
        span = (datetime.fromisoformat(days[-1]) -
                datetime.fromisoformat(days[0])).days + 1
        print()
        print(f"  active days: {active} of {span} in range · "
              f"peak {peak} ({fmt(by_day[peak]['out'])} output)")
    print()


HEAT_CHARS = " ░▒▓█"  # 5 levels, empty -> full


def view_heatmap(by_day, since, cao_only):
    scope = "cao-only" if cao_only else "all claude"
    days = sorted(by_day)
    print()
    print(f"  cao-tokens — claude output heatmap (GitHub-style)  [{scope}]")
    if not days:
        print("  (no claude usage in range)")
        print()
        return
    start = datetime.fromisoformat(days[0]).date()
    end = datetime.fromisoformat(days[-1]).date()
    # Align start to Monday so rows are clean weeks.
    start -= timedelta(days=start.weekday())
    maxv = max(by_day[d]["out"] for d in days) or 1

    def level(v):
        if v <= 0:
            return 0
        # log-ish buckets so a couple of huge days don't flatten the rest
        frac = v / maxv
        return 1 + min(3, int(frac * 4))

    # Build week columns; each column is Mon..Sun.
    weeks = []
    cur = start
    while cur <= end:
        col = []
        for _ in range(7):
            key = cur.isoformat()
            v = by_day.get(key, {}).get("out", 0) if key in by_day else 0
            col.append((cur, v))
            cur += timedelta(days=1)
        weeks.append(col)

    labels = ["Mon", "   ", "Wed", "   ", "Fri", "   ", "Sun"]
    for row in range(7):
        line = "  " + labels[row] + " "
        for col in weeks:
            _, v = col[row]
            line += HEAT_CHARS[level(v)]
        print(line)
    print()
    print(f"  span {days[0]} → {days[-1]} · "
          f"less {HEAT_CHARS[1]}{HEAT_CHARS[2]}{HEAT_CHARS[3]}{HEAT_CHARS[4]} more "
          f"· peak/day {fmt(maxv)} output")
    print("  (each column = one week, Mon top → Sun bottom; shade = output tokens)")
    print()


KNOWN_FLAGS = {
    "--json", "--all-sessions", "--since", "--day", "--extended", "-x",
    "--lifetime", "-a", "--heatmap", "--claude", "-h", "--help",
}


def valid_date(s):
    """True if s is YYYY-MM-DD."""
    try:
        datetime.strptime(s, "%Y-%m-%d")
        return True
    except ValueError:
        return False


def main():
    args = sys.argv[1:]

    if "-h" in args or "--help" in args:
        # The module docstring is the help text.
        print(__doc__.rstrip())
        return

    # Validate flags early so a typo fails loudly instead of silently no-op'ing.
    takes_value = {"--since", "--day"}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-") and a not in KNOWN_FLAGS:
            sys.exit(f"unknown flag '{a}'. Run: cao-tokens --help")
        if a in takes_value:
            if i + 1 >= len(args):
                sys.exit(f"'{a}' needs a value (e.g. {a} "
                         + ("7d" if a == "--since" else "2026-09-17") + ")")
            val = args[i + 1]
            if a == "--day" and not valid_date(val):
                sys.exit(f"--day expects a date as YYYY-MM-DD "
                         f"(e.g. --day 2026-09-17), got '{val}'")
            i += 1
        i += 1

    as_json = "--json" in args
    claude_view = "--claude" in args   # per-day CLAUDE only (needed for heatmap)
    since = None
    one_day = None
    if "--since" in args:
        since = args[args.index("--since") + 1]
    if "--day" in args:
        one_day = args[args.index("--day") + 1]

    # cao-only is the DEFAULT: for claude we count only sessions that loaded cao's
    # MCP server (a reliable marker). codex/opencode keep no such marker locally,
    # so their per-day totals are ALL of that engine's use — labeled ~all. In
    # practice you rarely run codex/opencode outside cao, so this is close enough
    # (a precise per-engine split would need request tracing, e.g. langfuse).
    # --all-sessions turns the claude filter off (count every Claude Code session).
    cao_only = "--all-sessions" not in args

    # DEFAULT window is the last 7 days. --since overrides it; --lifetime and a
    # single --day ignore the window.
    extended = "--extended" in args or "-x" in args
    lifetime = "--lifetime" in args or "-a" in args
    heatmap_only = "--heatmap" in args and not extended

    if since is None and not lifetime and one_day is None:
        since = "7d"     # the requested default: max ~1 week
    cutoff = cutoff_ts(since)

    # --- mode selection -----------------------------------------------------
    #   (no flag)      -> claude heatmap + per-day table across ALL engines, 7 days
    #   --claude       -> per-day CLAUDE-only table (in/out/cache)
    #   --heatmap      -> claude output heatmap only
    #   --extended     -> heatmap + claude daily + per-engine lifetime table
    #   --lifetime/-a  -> per-engine lifetime table only
    #   --day DATE     -> a single day
    #   --since N      -> override the 7-day window (24h/7d/2w)
    #   --all-sessions -> include non-cao claude sessions too
    claude_daily = claude_view or extended or heatmap_only

    if claude_daily:
        _, by_day = _scan_claude(cutoff, cao_only, per_day=True)

    if as_json:
        if lifetime:
            rows = (scrape_claude(cutoff, cao_only) +
                    scrape_codex(cutoff) + scrape_opencode(cutoff))
            print(json.dumps(rows, indent=2))
        elif claude_daily:
            print(json.dumps({d: by_day[d] for d in sorted(by_day)}, indent=2))
        else:
            days = scan_all_daily(cutoff, cao_only)
            print(json.dumps({d: days[d] for d in sorted(days)}, indent=2))
        return

    if heatmap_only:
        view_heatmap(by_day, since, cao_only)
        return

    if lifetime:
        rows = (scrape_claude(cutoff, cao_only) +
                scrape_codex(cutoff) + scrape_opencode(cutoff))
        view_table(rows, since, cao_only)
        return

    if extended:
        view_heatmap(by_day, since, cao_only)
        view_daily(by_day, since, cao_only, one_day=one_day)
        rows = (scrape_claude(cutoff, cao_only) +
                scrape_codex(cutoff) + scrape_opencode(cutoff))
        view_table(rows, since, cao_only)
        return

    if claude_view:
        view_daily(by_day, since, cao_only, one_day=one_day)
        return

    # DEFAULT: claude heatmap (quick 7-day overview) + per-day all-engine table.
    # A single --day skips the heatmap (one bar is pointless).
    if one_day is None:
        _, cl_by_day = _scan_claude(cutoff, cao_only, per_day=True)
        view_heatmap(cl_by_day, since, cao_only)
    days = scan_all_daily(cutoff, cao_only)
    view_daily_all(days, since, cao_only, one_day=one_day)


if __name__ == "__main__":
    main()

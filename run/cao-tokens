#!/usr/bin/env python3
"""cao-tokens — token usage across the CLI engines the orchestrator drives.

No vendor billing API is called. Everything here is scraped from the local files
each CLI writes on this machine:

  claude    ~/.claude/projects/**/*.jsonl   (per-message `usage` blocks)
  codex     ~/.codex/state_5.sqlite          (threads.tokens_used per model)
  opencode  ~/.local/share/opencode/opencode.db (session table, incl. real cost)
  agy       — no local usage log; Google quota is server-side (dashboard only)

These are LIFETIME LOCAL token counts, not a live plan-limit readout.

On COST: claude and codex here run on flat-rate SUBSCRIPTIONS — tokens do not
bill per unit, so no dollar figure is shown (a per-token estimate would be a
fiction, not a bill). Only opencode hits a real per-token endpoint, and its cost
column is the value opencode itself computed and stored — that's the only real $.

On CACHE: the cache column counts cached context RE-READ each turn, so the same
tokens are counted many times over a long session. It is cheap plumbing, not
fresh usage — read `output` (real generation) as the number that matters.

On SCOPE: by default the claude figure is EVERY Claude Code session on this
machine (all projects), not only the ones cao drove. That total spans many days
of ordinary Claude use — so a big lifetime number is NOT "cao burning your
limits". Use --cao-only to count just the sessions that loaded cao's MCP server
(supervisor + workers), and --daily / --heatmap to see it per day instead of one
lifetime lump. (codex & opencode totals stay lifetime — their local stores have
no reliable per-day timeline here.)

Usage:
  cao-tokens                    per-day table (DEFAULT — the number to watch)
  cao-tokens --extended  / -x   per-day table + heatmap + per-engine lifetime table
  cao-tokens --all-time  / -a   per-engine lifetime table only (the pre-2026-09 default)
  cao-tokens --day 2026-09-17   just that one date (what did "yesterday" actually cost)
  cao-tokens --heatmap          GitHub-style calendar heatmap only
  cao-tokens --cao-only         count only cao-driven claude sessions (composes with any mode)
  cao-tokens --since 7d         limit to the last 24h/7d/2w by message time (claude)
  cao-tokens --json             machine-readable (of whichever mode is selected)
  (flags compose: `--cao-only`, `-x --since 8w`, `--day D --cao-only`, etc.)
"""
import json
import os
import sqlite3
import sys
import time
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from glob import glob
from pathlib import Path

HOME = Path.home()

# Which engines bill per token. Only these get a $ column; the rest are flat-rate
# subscriptions where a per-token dollar figure would be meaningless.
METERED = {"opencode"}

# Markers that identify a claude session cao actually drove (supervisor/worker).
# cao profiles load the `cao-mcp-server` MCP server and use its `assign` tool;
# ordinary Claude Code sessions never touch these strings.
CAO_MARKERS = ("cao-mcp-server", "cao_", '"assign"')


def cutoff_ts(since):
    if not since:
        return 0.0
    n, unit = float(since[:-1]), since[-1]
    mult = {"h": 3600, "d": 86400, "w": 604800}.get(unit)
    if not mult:
        sys.exit(f"bad --since '{since}': use e.g. 24h, 7d, 2w")
    return time.time() - n * mult


def _iter_claude_files(cutoff):
    root = HOME / ".claude" / "projects"
    if not root.exists():
        return
    for f in glob(str(root / "**" / "*.jsonl"), recursive=True):
        # File-mtime prefilter is a cheap coarse gate; exact per-message time
        # filtering happens on the timestamp inside each row.
        if cutoff and os.path.getmtime(f) < cutoff:
            continue
        yield f


def _file_is_cao(path):
    """True if this session loaded cao's MCP server / used its assign tool."""
    try:
        with open(path, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                if any(m in line for m in CAO_MARKERS):
                    return True
    except OSError:
        return False
    return False


def _day_of(ts):
    """ISO date (UTC) from a claude timestamp like 2026-09-17T02:40:40.541Z."""
    if not ts:
        return None
    try:
        return ts[:10]
    except Exception:
        return None


# ---- claude scrape (shared core) -------------------------------------------
def _scan_claude(cutoff, cao_only, per_day):
    """Return (by_model, by_day). by_day is {date: dict(inp,out,cache)}."""
    by_model = {}
    by_day = defaultdict(lambda: dict(inp=0, out=0, cache=0))
    cutoff_dt = cutoff or 0
    for f in _iter_claude_files(cutoff):
        if cao_only and not _file_is_cao(f):
            continue
        try:
            fh = open(f, encoding="utf-8", errors="ignore")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"output_tokens"' not in line and '"input_tokens"' not in line:
                    continue
                try:
                    o = json.loads(line)
                except Exception:
                    continue
                msg = o.get("message") or {}
                u = msg.get("usage") or o.get("usage")
                if not u:
                    continue
                ts = o.get("timestamp")
                # Exact per-message time filter when --since is set.
                if cutoff_dt:
                    try:
                        mt = datetime.fromisoformat(
                            ts.replace("Z", "+00:00")).timestamp()
                        if mt < cutoff_dt:
                            continue
                    except Exception:
                        pass
                model = msg.get("model") or o.get("model") or "claude-unknown"
                inp = u.get("input_tokens", 0)
                out = u.get("output_tokens", 0)
                cache = u.get("cache_read_input_tokens", 0) + \
                    u.get("cache_creation_input_tokens", 0)
                a = by_model.setdefault(model, dict(inp=0, out=0, cache=0))
                a["inp"] += inp; a["out"] += out; a["cache"] += cache
                if per_day:
                    d = _day_of(ts)
                    if d:
                        by_day[d]["inp"] += inp
                        by_day[d]["out"] += out
                        by_day[d]["cache"] += cache
    return by_model, by_day


def scrape_claude(cutoff, cao_only=False):
    by_model, _ = _scan_claude(cutoff, cao_only, per_day=False)
    rows = []
    for model, a in by_model.items():
        if model in ("<synthetic>",) or a["inp"] + a["out"] + a["cache"] == 0:
            continue
        rows.append(dict(engine="claude", model=model, input=a["inp"],
                         output=a["out"], cache=a["cache"], cost=None))
    return rows


# ---- sqlite helpers --------------------------------------------------------
def _q(db, sql):
    if not Path(db).exists():
        return None
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        out = con.execute(sql).fetchall()
        con.close()
        return out
    except sqlite3.Error:
        return None


def scrape_codex(cutoff):
    db = HOME / ".codex" / "state_5.sqlite"
    rows = _q(db, "SELECT COALESCE(model,'?'), SUM(tokens_used) FROM threads GROUP BY model")
    if rows is None:
        return []
    out = []
    for model, toks in rows:
        toks = toks or 0
        if toks == 0:
            continue
        # codex reports one combined total, no in/out split.
        out.append(dict(engine="codex", model=model, input=toks, output=0,
                        cache=0, cost=None))
    return out


def scrape_opencode(cutoff):
    db = HOME / ".local" / "share" / "opencode" / "opencode.db"
    rows = _q(db, "SELECT COALESCE(model,'?'), SUM(tokens_input), SUM(tokens_output), "
                  "SUM(tokens_cache_read)+SUM(tokens_cache_write), SUM(cost) "
                  "FROM session GROUP BY model")
    if rows is None:
        return []
    out = []
    for model, ti, to, tc, cost in rows:
        ti, to, tc, cost = ti or 0, to or 0, tc or 0, cost or 0.0
        if ti + to + tc == 0:
            continue
        if model and model.startswith("{"):  # opencode stores model as JSON blob
            try:
                model = json.loads(model).get("id", model)
            except Exception:
                pass
        out.append(dict(engine="opencode", model=model, input=ti, output=to,
                        cache=tc, cost=round(cost, 4)))
    return out


def fmt(n):
    return f"{n:,}"


def cost_cell(r):
    if r["engine"] not in METERED:
        return "sub"           # flat-rate subscription — no per-token bill
    return f"{r['cost']:.2f}" if r["cost"] else "0.00"


# ---- views -----------------------------------------------------------------
def view_table(rows, since, cao_only):
    scope = "cao-only" if cao_only else "all claude sessions"
    print()
    print("  cao-tokens — local token counts" +
          (f"  (claude since {since})" if since else "  (lifetime)") +
          f"  [{scope}]")
    print("  " + "-" * 82)
    print(f"  {'engine':<9} {'model':<26} {'input':>12} {'output':>10} {'cache':>12} {'$':>6}")
    print("  " + "-" * 82)
    t_in = t_out = t_cache = 0
    t_cost = 0.0
    for r in sorted(rows, key=lambda r: -(r["output"] + r["input"])):
        print(f"  {r['engine']:<9} {r['model'][:26]:<26} {fmt(r['input']):>12} "
              f"{fmt(r['output']):>10} {fmt(r['cache']):>12} {cost_cell(r):>6}")
        t_in += r["input"]; t_out += r["output"]; t_cache += r["cache"]
        if r["engine"] in METERED and r["cost"]:
            t_cost += r["cost"]
    print("  " + "-" * 82)
    print(f"  {'TOTAL':<9} {'':<26} {fmt(t_in):>12} {fmt(t_out):>10} "
          f"{fmt(t_cache):>12} {t_cost:>6.2f}")
    print()
    print("  $  = real per-token cost (opencode endpoint only). 'sub' = flat-rate")
    print("       subscription (claude, codex) — tokens don't bill per unit.")
    print("  cache = context re-read each turn (same tokens counted repeatedly);")
    print("          it's cheap plumbing, not fresh usage. Read 'output' as spend.")
    print("  agy (gemini): no local usage log — quota is server-side (dashboard).")
    print("  scope: default counts ALL Claude Code sessions on this box; add")
    print("         --cao-only for just cao-driven ones, --daily/--heatmap per day.")
    print()


def view_daily(by_day, since, cao_only, one_day=None):
    scope = "cao-only" if cao_only else "all claude"
    print()
    if one_day:
        title = f"cao-tokens — claude output on {one_day}"
    else:
        title = "cao-tokens — claude output per day (LeetCode-style)"
    print(f"  {title}  [{scope}]")
    print("  " + "-" * 58)
    print(f"  {'date':<12} {'input':>12} {'output':>12} {'cache':>14}")
    print("  " + "-" * 58)
    days = sorted(by_day)
    if one_day:
        days = [d for d in days if d == one_day]
        if not days:
            print(f"  (no claude usage recorded on {one_day})")
            print()
            return
    t_in = t_out = t_cache = 0
    for d in days:
        a = by_day[d]
        # tiny inline bar scaled to the day's output within this window
        print(f"  {d:<12} {fmt(a['inp']):>12} {fmt(a['out']):>12} {fmt(a['cache']):>14}")
        t_in += a["inp"]; t_out += a["out"]; t_cache += a["cache"]
    print("  " + "-" * 58)
    print(f"  {'TOTAL':<12} {fmt(t_in):>12} {fmt(t_out):>12} {fmt(t_cache):>14}")
    if not one_day and days:
        # streak + peak, LeetCode/GitHub flavour
        peak = max(days, key=lambda d: by_day[d]["out"])
        active = len(days)
        span = (datetime.fromisoformat(days[-1]) -
                datetime.fromisoformat(days[0])).days + 1
        print()
        print(f"  active days: {active} of {span} in range · "
              f"peak {peak} ({fmt(by_day[peak]['out'])} output)")
    print()


HEAT_CHARS = " ░▒▓█"  # 5 levels, empty -> full


def view_heatmap(by_day, since, cao_only):
    scope = "cao-only" if cao_only else "all claude"
    days = sorted(by_day)
    print()
    print(f"  cao-tokens — claude output heatmap (GitHub-style)  [{scope}]")
    if not days:
        print("  (no claude usage in range)")
        print()
        return
    start = datetime.fromisoformat(days[0]).date()
    end = datetime.fromisoformat(days[-1]).date()
    # Align start to Monday so rows are clean weeks.
    start -= timedelta(days=start.weekday())
    maxv = max(by_day[d]["out"] for d in days) or 1

    def level(v):
        if v <= 0:
            return 0
        # log-ish buckets so a couple of huge days don't flatten the rest
        frac = v / maxv
        return 1 + min(3, int(frac * 4))

    # Build week columns; each column is Mon..Sun.
    weeks = []
    cur = start
    while cur <= end:
        col = []
        for _ in range(7):
            key = cur.isoformat()
            v = by_day.get(key, {}).get("out", 0) if key in by_day else 0
            col.append((cur, v))
            cur += timedelta(days=1)
        weeks.append(col)

    labels = ["Mon", "   ", "Wed", "   ", "Fri", "   ", "Sun"]
    for row in range(7):
        line = "  " + labels[row] + " "
        for col in weeks:
            _, v = col[row]
            line += HEAT_CHARS[level(v)]
        print(line)
    print()
    print(f"  span {days[0]} → {days[-1]} · "
          f"less {HEAT_CHARS[1]}{HEAT_CHARS[2]}{HEAT_CHARS[3]}{HEAT_CHARS[4]} more "
          f"· peak/day {fmt(maxv)} output")
    print("  (each column = one week, Mon top → Sun bottom; shade = output tokens)")
    print()


KNOWN_FLAGS = {
    "--json", "--cao-only", "--since", "--day", "--extended", "-x",
    "--all-time", "-a", "--heatmap", "--daily", "-h", "--help",
}


def main():
    args = sys.argv[1:]

    if "-h" in args or "--help" in args:
        # The module docstring is the help text.
        print(__doc__.rstrip())
        return

    # Validate flags early so a typo fails loudly instead of silently no-op'ing.
    takes_value = {"--since", "--day"}
    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("-") and a not in KNOWN_FLAGS:
            sys.exit(f"unknown flag '{a}'. Run: cao-tokens --help")
        if a in takes_value:
            if i + 1 >= len(args):
                sys.exit(f"'{a}' needs a value (e.g. {a} "
                         + ("7d" if a == "--since" else "2026-09-17") + ")")
            i += 1
        i += 1

    as_json = "--json" in args
    cao_only = "--cao-only" in args
    since = None
    one_day = None
    if "--since" in args:
        since = args[args.index("--since") + 1]
    if "--day" in args:
        one_day = args[args.index("--day") + 1]
    cutoff = cutoff_ts(since)

    # --- mode selection -----------------------------------------------------
    # Default is the per-day view (the number people actually want to watch).
    #   (no flag)        -> daily table
    #   --extended / -x  -> daily table + heatmap + per-engine lifetime table
    #   --all-time / -a  -> per-engine lifetime table only (the old default)
    #   --day DATE       -> a single day (implies daily)
    #   --heatmap        -> heatmap only  (kept as an explicit alias)
    #   --daily          -> daily only    (kept; it's already the default)
    extended = "--extended" in args or "-x" in args
    all_time = "--all-time" in args or "-a" in args
    heatmap_only = "--heatmap" in args and not extended
    # daily is the default unless the user asked for all-time-only
    want_daily = one_day is not None or "--daily" in args or extended or \
        (not all_time and not heatmap_only)

    # Day-resolved views only need claude (codex/opencode have no per-day store).
    if want_daily or heatmap_only or extended:
        _, by_day = _scan_claude(cutoff, cao_only, per_day=True)

    if as_json:
        # JSON returns whatever the selected mode is about, so scripts can pick.
        if all_time and not (want_daily or extended):
            rows = (scrape_claude(cutoff, cao_only) +
                    scrape_codex(cutoff) + scrape_opencode(cutoff))
            print(json.dumps(rows, indent=2))
        else:
            print(json.dumps({d: by_day[d] for d in sorted(by_day)}, indent=2))
        return

    if heatmap_only:
        view_heatmap(by_day, since, cao_only)
        return

    # Render in reading order: heatmap (overview) then daily (detail) then, in
    # extended mode, the per-engine lifetime table (the cross-engine picture).
    if extended:
        view_heatmap(by_day, since, cao_only)
    if want_daily:
        view_daily(by_day, since, cao_only, one_day=one_day)
    if all_time or extended:
        rows = (scrape_claude(cutoff, cao_only) +
                scrape_codex(cutoff) + scrape_opencode(cutoff))
        view_table(rows, since, cao_only)


if __name__ == "__main__":
    main()
